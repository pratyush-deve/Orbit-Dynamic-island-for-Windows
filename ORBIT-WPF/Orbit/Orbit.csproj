<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ORBIT.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>14.0</LangVersion>
    <Version>2.0.0</Version>
    <AssemblyTitle>ORBIT</AssemblyTitle>
    <Product>ORBIT Desktop Companion</Product>
    <Company>ORBIT</Company>
    <Description>ORBIT 2.0 Native Windows Desktop Companion</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ORBIT.ico" />
    <Resource Include="Assets\ORBIT.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>

  <Target Name="CopyWhisperRuntimesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <WhisperNativeFiles Include="$(TargetDir)runtimes\**\*.*" />
      <WhisperWinX64Files Include="$(TargetDir)runtimes\win-x64\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WhisperNativeFiles)" DestinationFolder="$(PublishDir)runtimes\%(RecursiveDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WhisperWinX64Files)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
