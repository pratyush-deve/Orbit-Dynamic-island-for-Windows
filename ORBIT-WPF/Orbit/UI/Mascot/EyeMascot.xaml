<UserControl x:Class="Orbit.UI.Mascot.EyeMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="140"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <Grid x:Name="MascotContainer">
        <!-- Optional outer glow effect applied directly to the pill -->
        <Border x:Name="PillBorder"
                Background="{DynamicResource Brush.Gradient.CharcoalSurface}"
                BorderBrush="{DynamicResource Brush.Gradient.PillBorder}"
                BorderThickness="1.5"
                CornerRadius="24"
                Padding="16,10"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            
            <Border.Effect>
                <DropShadowEffect x:Name="PillGlow"
                                  Color="{DynamicResource Color.Accent.PurpleLight}"
                                  BlurRadius="16"
                                  ShadowDepth="0"
                                  Opacity="0.5"/>
            </Border.Effect>

            <!-- Mascot Face Surface -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <!-- Left Eye -->
                <Grid Width="24" Height="28" Margin="0,0,12,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LeftEyeScale" CenterX="12" CenterY="14"/>
                    </Grid.RenderTransform>

                    <!-- Left Sclera -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource Brush.Eye.Sclera}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.15"/>
                        </Border.Effect>

                        <!-- Left Pupil Container (Clipped to Sclera) -->
                        <Grid ClipToBounds="True">
                            <Ellipse x:Name="LeftPupil"
                                     Width="13" Height="15"
                                     Fill="{DynamicResource Brush.Eye.Pupil}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="LeftPupilTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Left Specular Catchlight (Eye sparkle) -->
                            <Ellipse Width="4" Height="4"
                                     Fill="{DynamicResource Brush.Eye.Highlight}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="4,-4,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="LeftCatchlightTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Eye -->
                <Grid Width="24" Height="28">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="RightEyeScale" CenterX="12" CenterY="14"/>
                    </Grid.RenderTransform>

                    <!-- Right Sclera -->
                    <Border CornerRadius="12"
                            Background="{DynamicResource Brush.Eye.Sclera}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Color="#000000" Opacity="0.15"/>
                        </Border.Effect>

                        <!-- Right Pupil Container (Clipped to Sclera) -->
                        <Grid ClipToBounds="True">
                            <Ellipse x:Name="RightPupil"
                                     Width="13" Height="15"
                                     Fill="{DynamicResource Brush.Eye.Pupil}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="RightPupilTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- Right Specular Catchlight (Eye sparkle) -->
                            <Ellipse Width="4" Height="4"
                                     Fill="{DynamicResource Brush.Eye.Highlight}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Margin="4,-4,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="RightCatchlightTransform"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
