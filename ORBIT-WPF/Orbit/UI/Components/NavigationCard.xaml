<UserControl x:Class="Orbit.UI.Components.NavigationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="78" d:DesignWidth="68"
             Background="Transparent"
             Cursor="Hand"
             Focusable="True"
             MouseLeftButtonUp="OnCardMouseLeftButtonUp">

    <UserControl.Resources>
        <!-- Card Surface Gradients -->
        <LinearGradientBrush x:Key="CardBrush.Normal" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1D192C" Offset="0"/>
            <GradientStop Color="#151221" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Hover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2B2144" Offset="0"/>
            <GradientStop Color="#1E1732" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Pressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#181126" Offset="0"/>
            <GradientStop Color="#100B1A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Outer Interactive Card Surface with Tactile Scale Transform -->
    <Border x:Name="CardBorder"
            Background="{StaticResource CardBrush.Normal}"
            BorderBrush="#3D295F"
            BorderThickness="1.2"
            CornerRadius="10"
            Padding="3,5"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave"
            PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">

        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect x:Name="CardGlow"
                              Color="{DynamicResource Color.Accent.PurpleLight}"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.0"/>
        </Border.Effect>

        <!-- Vertical Jetpack Compose Card Flow -->
        <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <!-- Visual Icon / Graphic -->
                <RowDefinition Height="26"/>
                <!-- Badge / Title -->
                <RowDefinition Height="Auto"/>
                <!-- Subtitle / Label -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Visual Graphic Area -->
            <ContentPresenter x:Name="IconPresenter"
                              Grid.Row="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

            <!-- 2. Card Badge / Title -->
            <TextBlock x:Name="TxtBadge"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="10.5"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,2,0,0"/>

            <!-- 3. Card Subtitle / Label -->
            <TextBlock x:Name="TxtLabel"
                       Grid.Row="2"
                       HorizontalAlignment="Center"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="8.5"
                       FontWeight="Medium"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
