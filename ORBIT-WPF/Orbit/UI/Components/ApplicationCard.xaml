<UserControl x:Class="Orbit.UI.Components.ApplicationCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="76" d:DesignWidth="126"
             Background="Transparent"
             Cursor="Hand"
             Focusable="True"
             MouseLeftButtonUp="OnCardMouseLeftButtonUp">

    <UserControl.Resources>
        <!-- Card Background Gradients -->
        <LinearGradientBrush x:Key="CardBrush.Normal" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#1D192C" Offset="0"/>
            <GradientStop Color="#151221" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Hover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2C2148" Offset="0"/>
            <GradientStop Color="#1E1734" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Pressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#181126" Offset="0"/>
            <GradientStop Color="#100B1B" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Outer Interactive Card Surface -->
    <Border x:Name="CardBorder"
            Background="{StaticResource CardBrush.Normal}"
            BorderBrush="#3D295F"
            BorderThickness="1.2"
            CornerRadius="12"
            Padding="8,6,6,6"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave"
            PreviewMouseLeftButtonDown="OnCardPreviewMouseDown"
            PreviewMouseLeftButtonUp="OnCardPreviewMouseUp">

        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect x:Name="CardGlow"
                              Color="{DynamicResource Color.Accent.PurpleLight}"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.0"/>
        </Border.Effect>

        <!-- Vertical Flow Inside Card -->
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <!-- Row 0: App Icon & Top-Right Close Button -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: App Name -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Window Title -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: App Icon + Close Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Container -->
                <Grid Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <!-- Real Application Icon -->
                    <Image x:Name="ImgIcon"
                           Width="20"
                           Height="20"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                    <!-- Fallback App Icon Glyph -->
                    <Border x:Name="FallbackIcon"
                            Width="20"
                            Height="20"
                            CornerRadius="4"
                            Background="#2A1B46"
                            BorderBrush="#6B21A8"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Path Data="M2,4 L14,4 L14,12 L2,12 Z M2,6 L14,6"
                              Stroke="#C084FC"
                              StrokeThickness="1"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </Grid>

                <!-- Top-Right Close 'X' Button -->
                <Button x:Name="BtnClose"
                        Grid.Column="1"
                        Panel.ZIndex="10"
                        Width="20"
                        Height="20"
                        Margin="0,0,1,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBorder"
                                    Background="#221834"
                                    BorderBrush="#472C6F"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Cross 'X' Path -->
                                <Path x:Name="GlyphX"
                                      Data="M4,4 L10,10 M10,4 L4,10"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#4A183C"/>
                                    <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#E11D48"/>
                                    <Setter TargetName="GlyphX" Property="Stroke" Value="#FDA4AF"/>
                                    <Setter TargetName="CloseBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#E11D48" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="CloseBorder" Property="Background" Value="#2E0A1E"/>
                                    <Setter TargetName="CloseBorder" Property="BorderBrush" Value="#F43F5E"/>
                                    <Setter TargetName="CloseBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.92" ScaleY="0.92"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Row 1: Application Name -->
            <TextBlock x:Name="TxtAppName"
                       Grid.Row="1"
                       Margin="0,4,0,1"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Row 2: Window Title -->
            <TextBlock x:Name="TxtTitle"
                       Grid.Row="2"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="9"
                       FontWeight="Normal"
                       Foreground="{DynamicResource Brush.Text.Secondary}"
                       TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Border>
</UserControl>
