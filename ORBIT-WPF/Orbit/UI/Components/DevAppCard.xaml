<UserControl x:Class="Orbit.UI.Components.DevAppCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="76" d:DesignWidth="82"
             Width="82" Height="76"
             Background="Transparent"
             Cursor="Hand"
             Focusable="True"
             MouseLeftButtonUp="OnCardClicked">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="CardBrush.Default" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#261A42" Offset="0"/>
            <GradientStop Color="#18112A" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Hover" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#36225F" Offset="0"/>
            <GradientStop Color="#23173F" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CardBrush.Pressed" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#160E26" Offset="0"/>
            <GradientStop Color="#0F091A" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <!-- Outer Interactive Card Surface with Tactile Scale Transform -->
    <Border x:Name="CardBorder"
            Background="{StaticResource CardBrush.Default}"
            BorderBrush="#432B6E"
            BorderThickness="1.2"
            CornerRadius="10"
            Padding="4,6,4,5"
            RenderTransformOrigin="0.5,0.5"
            SnapsToDevicePixels="True"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave"
            PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp">

        <Border.RenderTransform>
            <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
        </Border.RenderTransform>

        <Border.Effect>
            <DropShadowEffect x:Name="CardGlow"
                              Color="#C084FC"
                              BlurRadius="10"
                              ShadowDepth="0"
                              Opacity="0.2"/>
        </Border.Effect>

        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <!-- Row 0: Application Icon -->
                <RowDefinition Height="32"/>
                <!-- Row 1: Application Name -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Real Application Icon -->
            <Grid Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30">
                <Image x:Name="ImgAppIcon"
                       Width="30"
                       Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- Fallback Monogram Icon if Image is null -->
                <Border x:Name="FallbackIcon"
                        Width="28"
                        Height="28"
                        Background="#261742"
                        BorderBrush="#5A2E9D"
                        BorderThickness="1"
                        CornerRadius="7"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFallbackGlyph"
                               Text="&lt;/&gt;"
                               FontFamily="{DynamicResource Font.Mono}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#C084FC"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 2. Application Name Beneath Icon -->
            <TextBlock x:Name="TxtAppName"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       FontFamily="{DynamicResource Font.Main}"
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Text.Primary}"
                       Margin="0,3,0,0"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="74"/>
        </Grid>
    </Border>
</UserControl>

