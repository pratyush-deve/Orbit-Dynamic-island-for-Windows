<UserControl x:Class="Orbit.UI.Panels.SystemControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:components="clr-namespace:Orbit.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="400">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown">
        <Grid.RowDefinitions>
            <!-- Row 0: Header with Back Button, Title, and CTRL Badge -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Single Row of 5 Equal-Sized Responsive Cards (Microphone | Wi-Fi | Bluetooth | Volume | Settings) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Back Button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Title & Badge -->
                <ColumnDefinition Width="*"/>
                <!-- Refresh Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to Home Dashboard Button -->
            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Left Arrow Glyph -->
                            <Path x:Name="ArrowGlyph"
                                  Data="M9,4 L5,8 L9,12 M5,8 L13,8"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="BackBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource Color.Accent.PurpleLight}"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                <Setter TargetName="BackBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="System Controls"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="#2B1A4A"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="CTRL"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                </Border>
            </StackPanel>

            <!-- Refresh Button -->
            <Button x:Name="BtnRefresh"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnRefreshClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RefreshBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Refresh Circular Arrow Glyph -->
                            <Path x:Name="RefreshGlyph"
                                  Data="M11,4 A4.5,4.5 0 1,0 13.5,8.5 M11,1.5 L11,4 L13.5,4"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RefreshBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="RefreshBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="RefreshGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RefreshBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="RefreshBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Single Horizontal Row: 5 Proportionally Equal-Sized Responsive Cards -->
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <!-- 1. Microphone Card -->
                <ColumnDefinition Width="1*"/>
                <!-- 2. Wi-Fi Card -->
                <ColumnDefinition Width="1*"/>
                <!-- 3. Bluetooth Card -->
                <ColumnDefinition Width="1*"/>
                <!-- 4. System Volume Card -->
                <ColumnDefinition Width="1*"/>
                <!-- 5. Windows Settings Card -->
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Microphone (Col 0) -->
            <components:SystemControlCard x:Name="CardMicrophone"
                                          Grid.Column="0"
                                          Margin="0,0,2.5,0"
                                          MinHeight="74"
                                          MaxHeight="82"
                                          VerticalAlignment="Stretch"
                                          ControlType="Microphone"
                                          Click="OnCardMicrophoneClicked"/>

            <!-- Card 2: Wi-Fi (Col 1) -->
            <components:SystemControlCard x:Name="CardWiFi"
                                          Grid.Column="1"
                                          Margin="2.5,0,2.5,0"
                                          MinHeight="74"
                                          MaxHeight="82"
                                          VerticalAlignment="Stretch"
                                          ControlType="WiFi"
                                          Click="OnCardWiFiClicked"/>

            <!-- Card 3: Bluetooth (Col 2) -->
            <components:SystemControlCard x:Name="CardBluetooth"
                                          Grid.Column="2"
                                          Margin="2.5,0,2.5,0"
                                          MinHeight="74"
                                          MaxHeight="82"
                                          VerticalAlignment="Stretch"
                                          ControlType="Bluetooth"
                                          Click="OnCardBluetoothClicked"/>

            <!-- Card 4: Volume (Col 3) -->
            <components:SystemControlCard x:Name="CardSystemVolume"
                                          Grid.Column="3"
                                          Margin="2.5,0,2.5,0"
                                          MinHeight="74"
                                          MaxHeight="82"
                                          VerticalAlignment="Stretch"
                                          ControlType="SystemVolume"
                                          Click="OnCardSystemVolumeClicked"/>

            <!-- Card 5: Windows Settings Card (Col 4) -->
            <components:SystemControlCard x:Name="CardSettings"
                                          Grid.Column="4"
                                          Margin="2.5,0,0,0"
                                          MinHeight="74"
                                          MaxHeight="82"
                                          VerticalAlignment="Stretch"
                                          ControlType="Settings"
                                          Click="OnCardSettingsClicked"/>
        </Grid>
    </Grid>
</UserControl>
