<UserControl x:Class="Orbit.UI.Panels.ManageAppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:Orbit.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="230" d:DesignWidth="400">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown">
        <Grid.RowDefinitions>
            <!-- Row 0: Header Toolbar with Back Button, Title, and Badge -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Search Box -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Vertically Scrollable Discovered Applications List -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <!-- Back Button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Title & Badge -->
                <ColumnDefinition Width="*"/>
                <!-- Refresh Discovery Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to DEV Mode Button -->
            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Left Arrow Glyph -->
                            <Path x:Name="ArrowGlyph"
                                  Data="M9,4 L5,8 L9,12 M5,8 L13,8"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="BackBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="BackBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Manage Apps"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="#2B1A4A"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="DEV CONFIGURATION"
                               FontSize="8.5"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                </Border>
            </StackPanel>

            <!-- Actions (Search Toggle + Refresh Discovery) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Toggle Search Field Button -->
                <Button x:Name="BtnToggleSearch"
                        Width="24"
                        Height="24"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="OnToggleSearchClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SearchBtnBorder"
                                    Background="#221834"
                                    BorderBrush="#472C6F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Magnifying Glass Glyph -->
                                <Path x:Name="SearchGlyph"
                                      Data="M8.5,8.5 L12,12 M9.5,5.5 A4,4 0 1,1 1.5,5.5 A4,4 0 1,1 9.5,5.5 Z"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SearchBtnBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="SearchBtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="SearchGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="SearchBtnBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="SearchBtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Refresh Discovery Button -->
                <Button x:Name="BtnRefresh"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        Cursor="Hand"
                        Click="OnRefreshClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RefreshBorder"
                                    Background="#221834"
                                    BorderBrush="#472C6F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Refresh Circular Arrow Glyph -->
                                <Path x:Name="RefreshGlyph"
                                      Data="M11,4 A4.5,4.5 0 1,0 13.5,8.5 M11,1.5 L11,4 L13.5,4"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RefreshBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="RefreshBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="RefreshGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="RefreshBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="RefreshBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Collapsible Search Field (Hidden by default to save vertical space) -->
        <Border x:Name="SearchPanel"
                Grid.Row="1"
                Background="#181126"
                BorderBrush="#3D295F"
                BorderThickness="1"
                CornerRadius="6"
                Height="28"
                Margin="0,0,0,8"
                Padding="6,0,6,0"
                Visibility="Collapsed">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Magnifier Glyph -->
                <Path Grid.Column="0"
                      Data="M8.5,8.5 L12,12 M9.5,5.5 A4,4 0 1,1 1.5,5.5 A4,4 0 1,1 9.5,5.5 Z"
                      Stroke="#7E6C99"
                      StrokeThickness="1.2"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"/>

                <!-- Search TextBox -->
                <TextBox x:Name="TxtSearch"
                         Grid.Column="1"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Brush.Text.Primary}"
                         CaretBrush="{DynamicResource Brush.Accent.PurpleLight}"
                         FontFamily="{DynamicResource Font.Main}"
                         FontSize="11"
                         VerticalAlignment="Center"
                         TextChanged="OnSearchTextChanged"/>

                <!-- Placeholder Text -->
                <TextBlock x:Name="TxtPlaceholder"
                           Grid.Column="1"
                           Text="Filter installed developer tools..."
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="11"
                           Foreground="#6C5B85"
                           IsHitTestVisible="False"
                           VerticalAlignment="Center"/>

                <!-- Clear Search Button -->
                <Button x:Name="BtnClearSearch"
                        Grid.Column="2"
                        Width="16"
                        Height="16"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="OnClearSearchClicked">
                    <Path Data="M4,4 L12,12 M12,4 L4,12"
                          Stroke="#7E6C99"
                          StrokeThickness="1.2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
        </Border>

        <!-- 3. Vertically Scrollable Applications List (Invisible scrollbar, smooth wheel scrolling) -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <ItemsControl x:Name="ItemsDiscoveredApps">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:DevAppRow App="{Binding}" Toggled="OnRowToggled"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty Filter Results Message -->
        <TextBlock x:Name="TxtNoResults"
                   Grid.Row="2"
                   Text="No developer tools match your search."
                   FontFamily="{DynamicResource Font.Main}"
                   FontSize="11"
                   Foreground="{DynamicResource Brush.Text.Muted}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="0,20,0,0"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>

