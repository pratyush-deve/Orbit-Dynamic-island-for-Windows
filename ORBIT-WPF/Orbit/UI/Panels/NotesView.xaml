<UserControl x:Class="Orbit.UI.Panels.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="470">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown">
        <Grid.RowDefinitions>
            <!-- Row 0: Minimal Toolbar with Back, Title, Save Status, Export, and Clear buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Editor & Vertical Scroll Progress Track -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Minimal Header Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Back Button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Title & Badge -->
                <ColumnDefinition Width="Auto"/>
                <!-- Save Status Indicator -->
                <ColumnDefinition Width="*"/>
                <!-- Actions: Export and Clear -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to Companion Dashboard Button -->
            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    ToolTip="Back to Dashboard"
                    Cursor="Hand"
                    Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Left Arrow Glyph -->
                            <Path x:Name="ArrowGlyph"
                                  Data="M9,4 L5,8 L9,12 M5,8 L13,8"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="BackBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                <Setter TargetName="BackBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Quick Notes"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="#2B1A4A"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="NOTES"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                </Border>
            </StackPanel>

            <!-- Subtle Saved / Saving Status Indicator -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="12,0,0,0">
                <Ellipse x:Name="StatusDot"
                         Width="5"
                         Height="5"
                         Fill="#10B981"
                         VerticalAlignment="Center"
                         Margin="0,0,5,0"/>
                <TextBlock x:Name="TxtSaveStatus"
                           Text="Saved"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="10"
                           FontWeight="Medium"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Right Toolbar Buttons (Export & Clear) -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                
                <!-- Save As / Export Button -->
                <Button x:Name="BtnExport"
                        Width="24"
                        Height="24"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        ToolTip="Export Notes (Save As...)"
                        Cursor="Hand"
                        Click="OnExportClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ExportBorder"
                                    Background="#221834"
                                    BorderBrush="#472C6F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Minimal Download / Export Floppy Icon -->
                                <Path x:Name="ExportGlyph"
                                      Data="M2,11 L2,12.5 C2,13.3 2.7,14 3.5,14 L12.5,14 C13.3,14 14,13.3 14,12.5 L14,11 M8,2 L8,10.5 M5,7.5 L8,10.5 L11,7.5"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ExportBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="ExportBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="ExportGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="ExportBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#C084FC"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ExportBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="ExportBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Clear Notes Button (Paintbrush) -->
                <Button x:Name="BtnClear"
                        Width="24"
                        Height="24"
                        VerticalAlignment="Center"
                        ToolTip="Clear Notes (Paintbrush)"
                        Cursor="Hand"
                        Click="OnClearClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ClearBorder"
                                    Background="#221834"
                                    BorderBrush="#472C6F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Minimal Paintbrush Glyph -->
                                <Path x:Name="ClearGlyph"
                                      Data="M11.5,1.5 C12.6,2.6 12.6,3.8 11.5,4.9 L9.5,6.9 L7.1,4.5 L9.1,2.5 C10.2,1.4 10.4,0.4 11.5,1.5 Z M6.5,5.1 L8.9,7.5 L4.2,12.2 C3.5,12.9 2.5,13.5 1.5,13.5 C1.5,12.5 2.1,11.5 2.8,10.8 L6.5,5.1 Z"
                                      Width="12"
                                      Height="12"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource Brush.Text.Muted}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ClearBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="ClearBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="ClearGlyph" Property="Fill" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="ClearBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#C084FC"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ClearBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="ClearBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Editor Container & Subtle Scroll Progress Bar -->
        <Border Grid.Row="1"
                Background="#171026"
                BorderBrush="#3D295F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,8,6,8"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Main Text Editor -->
                    <ColumnDefinition Width="*"/>
                    <!-- Tiny Vertical Scroll Progress Track -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Multiline Point/Bullet Text Editor -->
                <TextBox x:Name="TxtEditor"
                         Grid.Column="0"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="#F1F5F9"
                         CaretBrush="#C084FC"
                         SelectionBrush="#5B21B6"
                         FontFamily="{DynamicResource Font.Main}"
                         FontSize="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Hidden"
                         HorizontalScrollBarVisibility="Disabled"
                         SpellCheck.IsEnabled="False"
                         Padding="0"
                         Margin="0,0,4,0"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         TextChanged="OnEditorTextChanged"
                         PreviewKeyDown="OnEditorPreviewKeyDown"/>

                <!-- Unobtrusive Empty State Placeholder -->
                <TextBlock x:Name="TxtPlaceholder"
                           Grid.Column="0"
                           Text="Write quick notes, tasks, or bullet points here...&#x0a;• Auto-saves locally as you type&#x0a;• Press Enter after a bullet to continue list&#x0a;• Use Export to save to .txt or .md"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="11.5"
                           Foreground="#5A4775"
                           IsHitTestVisible="False"
                           Margin="2,2,0,0"
                           Visibility="Visible"/>

                <!-- Tiny Vertical Scroll Progress Indicator (2.5px wide, matching ORBIT theme) -->
                <Border x:Name="NotesScrollTrack"
                        Grid.Column="1"
                        Width="2.5"
                        Background="#221538"
                        BorderBrush="#3E2368"
                        BorderThickness="0.6"
                        CornerRadius="1.25"
                        Margin="4,2,2,2"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Right"
                        SnapsToDevicePixels="True"
                        IsHitTestVisible="False">
                    <Canvas x:Name="NotesScrollCanvas" ClipToBounds="True">
                        <Border x:Name="NotesScrollThumb"
                                Width="2.5"
                                Height="36"
                                Background="#A855F7"
                                CornerRadius="1.25"
                                SnapsToDevicePixels="True">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NotesScrollThumbTransform" Y="0"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#A855F7" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                        </Border>
                    </Canvas>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Confirmation Dialog Overlay for Clearing Notes -->
        <Border x:Name="ClearConfirmationOverlay"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="#D50C071A"
                CornerRadius="8"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="#201435"
                    BorderBrush="#5B21B6"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16,14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="320">
                <Border.Effect>
                    <DropShadowEffect Color="#C084FC" BlurRadius="16" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Clear All Notes?"
                               FontFamily="{DynamicResource Font.Main}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Text.Primary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>
                    
                    <TextBlock Text="This will clear your current notes and persistent storage."
                               FontFamily="{DynamicResource Font.Main}"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <!-- Cancel Button -->
                        <Button Content="Cancel"
                                Width="75"
                                Height="26"
                                Margin="0,0,8,0"
                                Background="#2A1B44"
                                Foreground="{DynamicResource Brush.Text.Primary}"
                                BorderBrush="#4A2F72"
                                BorderThickness="1"
                                Cursor="Hand"
                                Click="OnCancelClearClicked">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <!-- Confirm Clear Button -->
                        <Button Content="Clear"
                                Width="75"
                                Height="26"
                                Background="#5C1D2A"
                                Foreground="#FCA5A5"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="OnConfirmClearClicked">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>

