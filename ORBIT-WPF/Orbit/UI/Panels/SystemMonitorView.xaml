<UserControl x:Class="Orbit.UI.Panels.SystemMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="140" d:DesignWidth="440"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Back Button Style matching ORBIT panel standard -->
        <Style x:Key="MonitorBackBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C142A"/>
            <Setter Property="BorderBrush" Value="#3D295F"/>
            <Setter Property="Foreground" Value="#C4B5FD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2D1B48"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#180F26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Card Outer Border Style -->
        <Style x:Key="MetricCardBorderStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#23173D" Offset="0.0"/>
                        <GradientStop Color="#160D27" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#3D2660"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="6,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#8A2BE2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.35"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,0,2,2" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Four Equal Metric Cards in a Single Row -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource MonitorBackBtnStyle}"
                        Click="OnBackClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontWeight="Bold" Margin="0,0,4,0" Foreground="#C084FC"/>
                        <TextBlock Text="Back" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="System Monitor"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Live Status Pill Badge -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    Padding="7,2"
                    Background="#1E1430"
                    BorderBrush="#3D295F"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,5,0"/>
                    <TextBlock Text="LIVE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#10B981"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4 Individual Cards in a Single Horizontal Row -->
        <Grid Grid.Row="1" Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: CPU -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Width="13" Height="13" Margin="0,0,5,0"
                              Data="M2,2 H14 V14 H2 Z M5,5 H11 V11 H5 Z M0,5 H2 M0,8 H2 M0,11 H2 M14,5 H16 M14,8 H16 M14,11 H16 M5,0 V2 M8,0 V2 M11,0 V2 M5,14 V16 M8,14 V16 M11,14 V16"
                              Stroke="#C084FC" StrokeThickness="1.2" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#E9D5FF"/>
                    </StackPanel>

                    <!-- Primary Metric -->
                    <TextBlock Grid.Row="1" x:Name="TxtCpuUsage"
                               Text="0%"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Detail / Subtext -->
                    <TextBlock Grid.Row="2"
                               Text="Utilization"
                               FontSize="9.5"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 2: RAM -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Width="13" Height="13" Margin="0,0,5,0"
                              Data="M1,4 H15 V12 H1 Z M4,12 V14 M7,12 V14 M10,12 V14 M13,12 V14 M4,7 H6 V9 H4 Z M8,7 H10 V9 H8 Z M12,7 H14 V9 H12 Z"
                              Stroke="#C084FC" StrokeThickness="1.2" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="RAM" FontSize="11" FontWeight="Bold" Foreground="#E9D5FF"/>
                    </StackPanel>

                    <!-- Primary Metric -->
                    <TextBlock Grid.Row="1" x:Name="TxtRamPercent"
                               Text="0%"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Detail: Used / Total GB -->
                    <TextBlock Grid.Row="2" x:Name="TxtRamDetails"
                               Text="0.0 / 0.0 GB"
                               FontSize="9"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Card 3: Wi-Fi -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Width="13" Height="13" Margin="0,0,5,0"
                              Data="M1,3 C6,0 10,0 15,3 M3.5,6 C7,3.5 9,3.5 12.5,6 M6,9 C7.5,7.8 8.5,7.8 10,9 M8,12 A0.8,0.8 0 1,1 8,12.01"
                              Stroke="#C084FC" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi" FontSize="11" FontWeight="Bold" Foreground="#E9D5FF"/>
                    </StackPanel>

                    <!-- Speed Metrics: Download & Upload -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                            <TextBlock Text="↓ " FontSize="10.5" FontWeight="Bold" Foreground="#34D399"/>
                            <TextBlock x:Name="TxtWifiDownload" Text="0 B/s" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↑ " FontSize="10.5" FontWeight="Bold" Foreground="#60A5FA"/>
                            <TextBlock x:Name="TxtWifiUpload" Text="0 B/s" FontSize="10" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: GPU -->
            <Border Grid.Column="6" Style="{StaticResource MetricCardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon & Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Width="13" Height="13" Margin="0,0,5,0"
                              Data="M1,3 H15 V12 H1 Z M3,12 V14 M6,12 V14 M9,12 V14 M12,12 V14 M5,6.5 A1.5,1.5 0 1,1 5,6.51 M11,6.5 A1.5,1.5 0 1,1 11,6.51"
                              Stroke="#C084FC" StrokeThickness="1.2" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="#E9D5FF"/>
                    </StackPanel>

                    <!-- Primary Metric -->
                    <TextBlock Grid.Row="1" x:Name="TxtGpuUsage"
                               Text="0%"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                    <!-- Detail / Subtext -->
                    <TextBlock Grid.Row="2"
                               Text="Utilization"
                               FontSize="9.5"
                               Foreground="#94A3B8"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

