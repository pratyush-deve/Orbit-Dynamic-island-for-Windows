<UserControl x:Class="Orbit.UI.Panels.ExpandedIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mascot="clr-namespace:Orbit.UI.Mascot"
             xmlns:components="clr-namespace:Orbit.UI.Components"
             xmlns:panels="clr-namespace:Orbit.UI.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="240" d:DesignWidth="440">

    <Grid x:Name="RootIsland">
        <!-- Main Island Card Frame -->
        <Border Background="{DynamicResource Brush.Gradient.CharcoalSurface}"
                BorderBrush="{DynamicResource Brush.Gradient.PillBorder}"
                BorderThickness="1.5"
                CornerRadius="24"
                Margin="8">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource Color.Accent.PurpleLight}"
                                  BlurRadius="28"
                                  ShadowDepth="4"
                                  Opacity="0.45"/>
            </Border.Effect>

            <Grid Margin="14,10,14,14">
                <Grid.RowDefinitions>
                    <!-- Row 0: Eyes Mascot (clicking collapses) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 1: Expandable Island Body Content (revealed during Stage 2) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top-Left Task Manager Shortcut Button -->
                <Button x:Name="BtnTaskManager"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="26"
                        Height="22"
                        Margin="2,2,0,0"
                        Cursor="Hand"
                        Click="OnTaskManagerClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="#221C30"
                                    BorderBrush="#3D295F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Activity / Performance Pulse Line Icon -->
                                <Path x:Name="GlyphActivity"
                                      Data="M1,6 L4,6 L6.5,2 L9,10 L11.5,3.5 L13.5,6.5 L16,6"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="GlyphActivity" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="BtnBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#C084FC"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Top-Left File Explorer Shortcut Button -->
                <Button x:Name="BtnFileExplorer"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="26"
                        Height="22"
                        Margin="33,2,0,0"
                        Cursor="Hand"
                        Click="OnFileExplorerClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="#221C30"
                                    BorderBrush="#3D295F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <!-- Minimal Folder / File Explorer Icon -->
                                <Path x:Name="GlyphFolder"
                                      Data="M2,13 L2,4.5 C2,3.7 2.7,3 3.5,3 L5.8,3 C6.4,3 7,3.3 7.4,3.8 L8.4,5 L12.5,5 C13.3,5 14,5.7 14,6.5 L14,13 C14,13.8 13.3,14.5 12.5,14.5 L3.5,14.5 C2.7,14.5 2,13.8 2,13 Z"
                                      Width="13"
                                      Height="11"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="GlyphFolder" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="BtnBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#C084FC"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 1. Expressive Mascot Eyes at the top -->
                <mascot:EyeMascot x:Name="IslandMascot"
                                  Grid.Row="0"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,6"
                                  Cursor="Hand"
                                  MouseLeftButtonDown="OnMascotClicked"/>

                <!-- Top-Right Tiny Text Hide Button (Hides to system tray) -->
                <Button x:Name="BtnHidePanel"
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Height="22"
                        Margin="0,2,2,0"
                        Cursor="Hand"
                        Click="OnHideButtonClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder"
                                    Background="#221C30"
                                    BorderBrush="#3D295F"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8,2"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                </Border.RenderTransform>

                                <TextBlock x:Name="BtnText"
                                           Text="Hide"
                                           FontFamily="{DynamicResource Font.Main}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#352458"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    <Setter TargetName="BtnText" Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
                                    <Setter TargetName="BtnBorder" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#C084FC"
                                                              BlurRadius="8"
                                                              ShadowDepth="0"
                                                              Opacity="0.6"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#1C1032"/>
                                    <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 2. Body Content (Header Branding and 4 Jetpack Compose Navigation Cards) -->
                <!-- 2. Body Content Container: Home 4-Cards View vs Active Apps Manager View -->
                <Grid x:Name="IslandBodyContent"
                      Grid.Row="1"
                      Opacity="1.0"
                      HorizontalAlignment="Stretch"
                      ClipToBounds="False">

                    <!-- View A: Navigation Cards (Home View) -->
                    <Grid x:Name="HomeContentView"
                          Visibility="Visible"
                          Opacity="1.0"
                          HorizontalAlignment="Stretch"
                          ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <!-- Row 0: Header Branding: ORBIT + v2.0 + Subtitle -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 1: Horizontally Scrollable Interactive Navigation Cards Row -->
                            <RowDefinition Height="Auto"/>
                            <!-- Row 2: Subtle Horizontal Scroll Progress Indicator -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Section: Centered ORBIT Branding & Right-Aligned NOTES Card -->
                        <Grid Grid.Row="0" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                            <!-- Center: ORBIT + v2.0 + Subtitle -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="ORBIT"
                                               FontFamily="{DynamicResource Font.Main}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource Brush.Text.Primary}">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="{DynamicResource Color.Accent.PurpleLight}" Opacity="0.55" ShadowDepth="0"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <Border Background="#2B1A4A"
                                            BorderBrush="{DynamicResource Brush.Accent.Border}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="v2.0"
                                                   FontSize="9.5"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                                    </Border>
                                </StackPanel>

                                <TextBlock Text="YOUR DESKTOP COMPANION"
                                           FontFamily="{DynamicResource Font.Main}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Text.Muted}"
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Right: Compact NOTES Card -->
                            <Button x:Name="BtnNotesCard"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Cursor="Hand"
                                    Click="OnNotesButtonClicked">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NotesCardBorder"
                                                Background="#1E1630"
                                                BorderBrush="#3D295F"
                                                BorderThickness="1.2"
                                                CornerRadius="9"
                                                Padding="9,5"
                                                RenderTransformOrigin="0.5,0.5"
                                                SnapsToDevicePixels="True">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                                            </Border.RenderTransform>

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <!-- Minimal Notebook Icon -->
                                                <Path x:Name="GlyphNotes"
                                                      Data="M2.5,2 L10.5,2 C11,2 11.5,2.5 11.5,3 L11.5,13 C11.5,13.5 11,14 10.5,14 L2.5,14 C2,14 1.5,13.5 1.5,13 L1.5,3 C1.5,2.5 2,2 2.5,2 Z M4,5 L9,5 M4,8 L9,8 M4,11 L7,11"
                                                      Width="11"
                                                      Height="11"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource Brush.Text.Muted}"
                                                      StrokeThickness="1.3"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>

                                                <!-- NOTES Label -->
                                                <TextBlock x:Name="TxtNotesLabel"
                                                           Text="NOTES"
                                                           FontFamily="{DynamicResource Font.Main}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.Text.Primary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NotesCardBorder" Property="Background" Value="#2E204A"/>
                                                <Setter TargetName="NotesCardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                                <Setter TargetName="GlyphNotes" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                                <Setter TargetName="TxtNotesLabel" Property="Foreground" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                                <Setter TargetName="NotesCardBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#C084FC"
                                                                          BlurRadius="8"
                                                                          ShadowDepth="0"
                                                                          Opacity="0.6"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="NotesCardBorder" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="1.03" ScaleY="1.03"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="NotesCardBorder" Property="Background" Value="#171026"/>
                                                <Setter TargetName="NotesCardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                                <Setter TargetName="NotesCardBorder" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Horizontally Scrollable Interactive Navigation Cards Row -->
                        <ScrollViewer x:Name="HomeCardsScrollViewer"
                                      Grid.Row="1"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Disabled"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      MinHeight="106"
                                      Focusable="False"
                                      CanContentScroll="False"
                                      PanningMode="HorizontalOnly"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="0"
                                      ScrollChanged="OnHomeCardsScrollChanged"
                                      PreviewMouseWheel="OnHomeCardsScrollViewerPreviewMouseWheel">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,4,2,8">
                                <!-- Card 1: Dev Mode -->
                                <components:NavigationCard x:Name="CardDevMode"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,10,0"
                                                           CardBadge="DEV"
                                                           CardLabel="Dev Mode"
                                                           Click="OnCardDevModeClicked">
                                    <Border Background="#23173B"
                                            BorderBrush="#532692"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="7,3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="&lt;/&gt;"
                                                   FontFamily="{DynamicResource Font.Mono}"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   Foreground="#C084FC"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </components:NavigationCard>

                                <!-- Card 2: Active Apps -->
                                <components:NavigationCard x:Name="CardActiveApps"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,10,0"
                                                           CardBadge="APPS"
                                                           CardLabel="Active Apps"
                                                           Click="OnCardActiveAppsClicked">
                                    <Grid Width="28" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Back Application Window Layer -->
                                        <Border Width="20" Height="15"
                                                CornerRadius="3"
                                                Background="#1A142B"
                                                BorderBrush="#4C2882"
                                                BorderThickness="1"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"/>

                                        <!-- Front Application Window Layer -->
                                        <Border Width="22" Height="17"
                                                CornerRadius="4"
                                                Background="#291C44"
                                                BorderBrush="#A855F7"
                                                BorderThickness="1.2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Bottom">
                                            <Grid Margin="3,2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Mini Window Titlebar Dots -->
                                                <StackPanel Orientation="Horizontal" Grid.Row="0">
                                                    <Ellipse Width="2.5" Height="2.5" Fill="#C084FC" Margin="0,0,1.5,0"/>
                                                    <Ellipse Width="2.5" Height="2.5" Fill="#A855F7" Margin="0,0,1.5,0"/>
                                                    <Ellipse Width="2.5" Height="2.5" Fill="#6B21A8"/>
                                                </StackPanel>
                                                <!-- Application Content Lines -->
                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,1.5,0,0">
                                                    <Rectangle Height="1.5" Fill="#6D28D9" RadiusX="0.75" RadiusY="0.75" Margin="0,0,3,1.5"/>
                                                    <Rectangle Height="1.5" Fill="#4C1D95" RadiusX="0.75" RadiusY="0.75" Margin="0,0,6,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </components:NavigationCard>

                                <!-- Card 3: AI Agent -->
                                <components:NavigationCard x:Name="CardAiAgent"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,10,0"
                                                           CardBadge="AI"
                                                           CardLabel="AI Agent"
                                                           Click="OnCardAiAgentClicked">
                                    <Grid Width="28" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <!-- Primary 4-point AI neural sparkle -->
                                        <Path Data="M12,1 C12,6.5 14,8.5 20,11 C14,13.5 12,15.5 12,21 C12,15.5 10,13.5 4,11 C10,8.5 12,6.5 12,1 Z"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center">
                                            <Path.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#F3E8FF" Offset="0"/>
                                                    <GradientStop Color="#A855F7" Offset="0.6"/>
                                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                            <Path.Effect>
                                                <DropShadowEffect Color="#C084FC" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                            </Path.Effect>
                                        </Path>

                                        <!-- Secondary micro sparkle (Top-Right) -->
                                        <Path Data="M22,1 C22,3 22.5,3.5 24.5,5 C22.5,6.5 22,7 22,9 C22,7 21.5,6.5 19.5,5 C21.5,3.5 22,3 22,1 Z"
                                              Fill="#E9D5FF"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Top"
                                              Margin="0,0,1,0"/>
                                    </Grid>
                                </components:NavigationCard>

                                <!-- Card 4: Quick Controls -->
                                <components:NavigationCard x:Name="CardControls"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,10,0"
                                                           CardBadge="CTRL"
                                                           CardLabel="Controls"
                                                           Click="OnCardControlsClicked">
                                    <Grid Width="28" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="1*"/>
                                            <RowDefinition Height="1*"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 1. Wi-Fi wave icon (Top-Left) -->
                                        <Canvas Grid.Row="0" Grid.Column="0" Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M1,2 A7,7 0 0,1 11,2" Stroke="#C084FC" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M3,4.5 A4.5,4.5 0 0,1 9,4.5" Stroke="#A855F7" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Path Data="M5,7 A2,2 0 0,1 7,7" Stroke="#8A2BE2" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <Ellipse Canvas.Left="5.25" Canvas.Top="8.5" Width="1.5" Height="1.5" Fill="#F8FAFC"/>
                                        </Canvas>

                                        <!-- 2. Bluetooth rune icon (Top-Right) -->
                                        <Canvas Grid.Row="0" Grid.Column="1" Width="12" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M4,0.5 L8,3.5 L5,5.5 L8,7.5 L4,10.5 M4,0.5 L4,10.5 M4,3.5 L7.5,5.5 L4,7.5"
                                                  Stroke="#C084FC"
                                                  StrokeThickness="1.1"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"/>
                                        </Canvas>

                                        <!-- 3. Microphone icon (Bottom-Left) -->
                                        <Canvas Grid.Row="1" Grid.Column="0" Width="12" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Mic capsule -->
                                            <Rectangle Canvas.Left="4" Canvas.Top="0.5" Width="4" Height="6" RadiusX="2" RadiusY="2"
                                                       Fill="#2A1846" Stroke="#A855F7" StrokeThickness="1"/>
                                            <!-- Mic cup & stand -->
                                            <Path Data="M2,4 A4,4 0 0,0 10,4 M6,7.5 L6,10 M3.5,10 L8.5,10"
                                                  Stroke="#A855F7" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>

                                        <!-- 4. Audio/Speaker icon (Bottom-Right) -->
                                        <Canvas Grid.Row="1" Grid.Column="1" Width="12" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Speaker cone -->
                                            <Path Data="M1.5,4 L3.5,4 L6.5,1.5 L6.5,9.5 L3.5,7 L1.5,7 Z"
                                                  Fill="#2A1846" Stroke="#C084FC" StrokeThickness="1" StrokeLineJoin="Round"/>
                                            <!-- Sound waves -->
                                            <Path Data="M8.5,3.5 A3.5,3.5 0 0,1 8.5,7.5 M10.5,1.8 A6,6 0 0,1 10.5,9.2"
                                                  Stroke="#C084FC" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Grid>
                                </components:NavigationCard>

                                <!-- Card 5: Social Hub -->
                                <components:NavigationCard x:Name="CardSocial"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,10,0"
                                                           CardBadge="SOCIAL"
                                                           CardLabel="Social Hub"
                                                           Click="OnCardSocialClicked">
                                    <Grid Width="28" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Back User (Purple Muted) -->
                                            <Path Data="M16,3.5 A3.5,3.5 0 0,1 16,10.5"
                                                  Stroke="#7C3AED"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                            <Path Data="M20.5,19.5 C20.5,16.5 18,14.5 15.5,14"
                                                  Stroke="#7C3AED"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>

                                            <!-- Front User (Bright Glowing Purple) -->
                                            <Ellipse Canvas.Left="4" Canvas.Top="2"
                                                     Width="7.5" Height="7.5"
                                                     Stroke="#C084FC"
                                                     StrokeThickness="1.4"
                                                     Fill="#201538"/>
                                            <Path Data="M1.5,19.5 C1.5,15.5 4.5,13.5 7.8,13.5 C11,13.5 14,15.5 14,19.5"
                                                  Stroke="#C084FC"
                                                  StrokeThickness="1.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>

                                            <!-- Active Social Notification Indicator -->
                                            <Ellipse Canvas.Left="19" Canvas.Top="2"
                                                     Width="3" Height="3"
                                                     Fill="#C084FC">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect Color="#C084FC" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/>
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </Canvas>
                                    </Grid>
                                </components:NavigationCard>

                                <!-- Card 6: Work / Productivity -->
                                <components:NavigationCard x:Name="CardWork"
                                                           Width="94"
                                                           Height="94"
                                                           Margin="0,0,0,0"
                                                           CardBadge="WORK"
                                                           CardLabel="Productivity"
                                                           Click="OnCardWorkClicked">
                                    <Grid Width="28" Height="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- Briefcase Handle -->
                                            <Path Data="M8,7 V4.5 C8,3.7 8.7,3 9.5,3 H14.5 C15.3,3 16,3.7 16,4.5 V7"
                                                  Stroke="#A855F7"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>

                                            <!-- Briefcase Body -->
                                            <Border Canvas.Left="2" Canvas.Top="6.5"
                                                    Width="20" Height="14"
                                                    CornerRadius="3"
                                                    Background="#201538"
                                                    BorderBrush="#C084FC"
                                                    BorderThickness="1.3">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.5"/>
                                                </Border.Effect>
                                                <Grid>
                                                    <!-- Horizontal seam -->
                                                    <Rectangle Height="1.2" Fill="#7C3AED" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                                    <!-- Center lock latch -->
                                                    <Border Width="5" Height="3.5"
                                                            Background="#A855F7"
                                                            CornerRadius="1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="0,1,0,0"/>
                                                </Grid>
                                            </Border>
                                        </Canvas>
                                    </Grid>
                                </components:NavigationCard>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Row 2: Subtle Horizontal Scroll Progress Indicator (2.5px) -->
                        <Border x:Name="HomeCardsScrollTrack"
                                Grid.Row="2"
                                Width="120"
                                Height="2.5"
                                Background="#221538"
                                BorderBrush="#3E2368"
                                BorderThickness="0.8"
                                CornerRadius="1.25"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,4"
                                SnapsToDevicePixels="True"
                                IsHitTestVisible="False">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border x:Name="HomeCardsScrollThumb"
                                        Height="2.5"
                                        Width="36"
                                        HorizontalAlignment="Left"
                                        Background="#A855F7"
                                        CornerRadius="1.25"
                                        SnapsToDevicePixels="True">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="HomeCardsScrollThumbTransform" X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#A855F7" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- View B: Active Apps Manager View -->
                    <Grid x:Name="ActiveAppsContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:ActiveAppsView x:Name="ActiveAppsPanel"
                                               BackRequested="OnActiveAppsBackRequested"/>
                    </Grid>

                    <!-- View C: Quick Controls View -->
                    <Grid x:Name="ControlsContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:SystemControlsView x:Name="ControlsPanel"
                                                   BackRequested="OnControlsBackRequested"/>
                    </Grid>

                    <!-- View D: Developer Mode Main Workspace View -->
                    <Grid x:Name="DevModeContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:DevModeView x:Name="DevModePanel"
                                            BackRequested="OnDevModeBackRequested"
                                            ManageAppsRequested="OnDevModeManageAppsRequested"/>
                    </Grid>

                    <!-- View E: Manage Apps Configuration View -->
                    <Grid x:Name="ManageAppsContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:ManageAppsView x:Name="ManageAppsPanel"
                                               BackRequested="OnManageAppsBackRequested"/>
                    </Grid>

                    <!-- View F: AI Agent Monitor View -->
                    <Grid x:Name="AiMonitorContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:AiAgentMonitorView x:Name="AiMonitorPanel"
                                                   BackRequested="OnAiMonitorBackRequested"/>
                    </Grid>

                    <!-- View G: Social Hub View -->
                    <Grid x:Name="SocialHubContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:SocialHubView x:Name="SocialHubPanel"
                                              BackRequested="OnSocialHubBackRequested"
                                              ManageAppsRequested="OnSocialHubManageAppsRequested"/>
                    </Grid>

                    <!-- View H: Manage Social Apps View -->
                    <Grid x:Name="ManageSocialAppsContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:ManageHubAppsView x:Name="ManageSocialAppsPanel"
                                                  BackRequested="OnManageSocialAppsBackRequested"/>
                    </Grid>

                    <!-- View I: Work Hub View -->
                    <Grid x:Name="WorkHubContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:WorkHubView x:Name="WorkHubPanel"
                                            BackRequested="OnWorkHubBackRequested"
                                            ManageAppsRequested="OnWorkHubManageAppsRequested"/>
                    </Grid>

                    <!-- View J: Manage Work Apps View -->
                    <Grid x:Name="ManageWorkAppsContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:ManageHubAppsView x:Name="ManageWorkAppsPanel"
                                                  BackRequested="OnManageWorkAppsBackRequested"/>
                    </Grid>

                    <!-- View K: Dedicated Quick Notes View -->
                    <Grid x:Name="NotesContainer"
                          Visibility="Collapsed"
                          Opacity="0.0"
                          HorizontalAlignment="Stretch">
                        <panels:NotesView x:Name="NotesPanel"
                                          BackRequested="OnNotesBackRequested"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
