<UserControl x:Class="Orbit.UI.Panels.AiAgentMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignWidth="400"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- See Output Button Style -->
        <Style x:Key="SeeOutputButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#25163C"/>
            <Setter Property="Foreground" Value="#E9D5FF"/>
            <Setter Property="BorderBrush" Value="#8A2BE2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="8,2">
                            <Border.Effect>
                                <DropShadowEffect Color="#8A2BE2" BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B1D5E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C084FC"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A0D2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Back Button Style -->
        <Style x:Key="AiBackBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1C142A"/>
            <Setter Property="BorderBrush" Value="#3D295F"/>
            <Setter Property="Foreground" Value="#C4B5FD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="8,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2D1B48"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#A855F7"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="2,2,2,4">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Content Area -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource AiBackBtnStyle}"
                        Click="OnBackClicked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="←" FontWeight="Bold" Margin="0,0,4,0" Foreground="#C084FC"/>
                        <TextBlock Text="Back" FontSize="10.5" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="AI Activity Monitor"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Active / Running summary indicator -->
            <Border x:Name="BadgeSummaryStatus"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    CornerRadius="9"
                    Padding="7,2"
                    Background="#1E1430"
                    BorderBrush="#3D295F"
                    BorderThickness="1">
                <TextBlock x:Name="TxtSummaryStatus"
                           Text="MONITORING"
                           FontSize="9"
                           FontWeight="Bold"
                           Foreground="#A855F7"/>
            </Border>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- Empty State: Neither Application Running -->
            <Border x:Name="PanelEmptyState"
                    Visibility="Collapsed"
                    Background="#140E20"
                    BorderBrush="#2A1B3D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✦"
                               FontSize="16"
                               Foreground="#8B7A9F"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="No Antigravity applications running."
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               Foreground="#D8B4FE"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Launch Antigravity or Antigravity IDE to monitor agent activities."
                               FontSize="9.5"
                               Foreground="#7C6D91"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Cards Container: 1 or 2 running apps -->
            <Grid x:Name="GridCardsContainer" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColCard1" Width="*"/>
                    <ColumnDefinition x:Name="ColSpacer" Width="10"/>
                    <ColumnDefinition x:Name="ColCard2" Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Card: Regular Antigravity -->
                <Border x:Name="CardAntigravity"
                        Grid.Column="0"
                        Background="#171026"
                        BorderBrush="#3D295F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,9"
                        Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Name, State Badge -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="ImgAgIcon" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Antigravity"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"/>
                            </StackPanel>

                            <!-- State Badge -->
                            <Border x:Name="BadgeAgState"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="7"
                                    Padding="6,2"
                                    Background="#201633">
                                <TextBlock x:Name="TxtAgState"
                                           Text="IDLE"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="#8B7A9F"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Task Title -->
                        <Grid Grid.Row="1" MinHeight="32" Margin="0,6,0,8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtAgTaskTitle"
                                       Text="Standing by"
                                       FontSize="10.5"
                                       Foreground="#E2E8F0"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       MaxHeight="32"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Bottom: See Output Action Button -->
                        <Button Grid.Row="2"
                                Height="26"
                                Style="{StaticResource SeeOutputButtonStyle}"
                                Content="See Output"
                                HorizontalAlignment="Stretch"
                                Click="OnAgSeeOutputClicked"/>
                    </Grid>
                </Border>

                <!-- Card: Antigravity IDE -->
                <Border x:Name="CardAntigravityIde"
                        Grid.Column="2"
                        Background="#171026"
                        BorderBrush="#3D295F"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,9"
                        Visibility="Visible">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header: Icon, Name, State Badge -->
                        <Grid Grid.Row="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="ImgIdeIcon" Width="18" Height="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Antigravity IDE"
                                           FontSize="11.5"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="7,0,0,0"/>
                            </StackPanel>

                            <!-- State Badge -->
                            <Border x:Name="BadgeIdeState"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    CornerRadius="7"
                                    Padding="6,2"
                                    Background="#201633">
                                <TextBlock x:Name="TxtIdeState"
                                           Text="IDLE"
                                           FontSize="8.5"
                                           FontWeight="Bold"
                                           Foreground="#8B7A9F"/>
                            </Border>
                        </Grid>

                        <!-- Middle: Task Title -->
                        <Grid Grid.Row="1" MinHeight="32" Margin="0,6,0,8" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtIdeTaskTitle"
                                       Text="Standing by"
                                       FontSize="10.5"
                                       Foreground="#E2E8F0"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap"
                                       MaxHeight="32"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Bottom: See Output Action Button -->
                        <Button Grid.Row="2"
                                Height="26"
                                Style="{StaticResource SeeOutputButtonStyle}"
                                Content="See Output"
                                HorizontalAlignment="Stretch"
                                Click="OnIdeSeeOutputClicked"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
