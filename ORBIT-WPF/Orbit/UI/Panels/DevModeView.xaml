<UserControl x:Class="Orbit.UI.Panels.DevModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:Orbit.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="220" d:DesignWidth="400">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown">
        <Grid.RowDefinitions>
            <!-- Row 0: Header with Back Button, Title, and Settings Gear Icon -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Dynamic Developer Application Cards Workspace Area -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Prominent ACTIVATE Button -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <!-- Back Button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Title & Badge -->
                <ColumnDefinition Width="*"/>
                <!-- Settings Gear Icon Button (Manage Apps) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to Dashboard Button -->
            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    ToolTip="Back to Dashboard"
                    Cursor="Hand"
                    Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Left Arrow Glyph -->
                            <Path x:Name="ArrowGlyph"
                                  Data="M9,4 L5,8 L9,12 M5,8 L13,8"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="BackBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource Color.Accent.PurpleLight}"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                <Setter TargetName="BackBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Dev Mode"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="#2B1A4A"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="WORKSPACE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                </Border>
            </StackPanel>

            <!-- Settings Gear Button -> Navigates to Manage Apps -->
            <Button x:Name="BtnManageApps"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    ToolTip="Manage Developer Apps"
                    Cursor="Hand"
                    Click="OnManageAppsClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SettingsBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Gear Glyph -->
                            <Path x:Name="GearGlyph"
                                  Data="M9,2 L11,2 L11.3,3.5 C11.7,3.6 12.1,3.8 12.4,4.1 L13.8,3.3 L14.8,4.3 L14,5.7 C14.3,6 14.5,6.4 14.6,6.8 L16.1,7.1 L16.1,8.9 L14.6,9.2 C14.5,9.6 14.3,10 14,10.3 L14.8,11.7 L13.8,12.7 L12.4,11.9 C12.1,12.2 11.7,12.4 11.3,12.5 L11,14 L9,14 L8.7,12.5 C8.3,12.4 7.9,12.2 7.6,11.9 L6.2,12.7 L5.2,11.7 L6,10.3 C5.7,10 5.5,9.6 5.4,9.2 L3.9,8.9 L3.9,7.1 L5.4,6.8 C5.5,6.4 5.7,6 6,5.7 L5.2,4.3 L6.2,3.3 L7.6,4.1 C7.9,3.8 8.3,3.6 8.7,3.5 Z M10,5.8 A2.2,2.2 0 1,0 10,10.2 A2.2,2.2 0 1,0 10,5.8 Z"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SettingsBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="SettingsBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="GearGlyph" Property="Fill" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="SettingsBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource Color.Accent.PurpleLight}"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SettingsBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="SettingsBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Dynamic Adaptive Application Workspace Cards -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      VerticalAlignment="Stretch"
                      Margin="0,0,0,6">
            <ItemsControl x:Name="ItemsWorkspaceApps">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:DevAppCard App="{Binding}" Margin="3"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty Workspace Fallback if 0 apps are selected -->
        <Border x:Name="EmptyWorkspacePrompt"
                Grid.Row="1"
                Background="#160F24"
                BorderBrush="#3D295F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,14"
                Margin="0,4,0,8"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No applications selected"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Click the ⚙️ icon above to add tools"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="9.5"
                           Foreground="#7C6D96"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 3. Prominent Neon-Purple ACTIVATE Button -->
        <Button x:Name="BtnActivate"
                Grid.Row="2"
                Height="34"
                Margin="0,2,0,0"
                HorizontalAlignment="Stretch"
                Cursor="Hand"
                Click="OnActivateClicked">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ActivateBorder"
                            CornerRadius="8"
                            BorderThickness="1.2"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="#6D28D9" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#C084FC" Offset="0"/>
                                <GradientStop Color="#A855F7" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>

                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BtnScale" ScaleX="1.0" ScaleY="1.0"/>
                        </Border.RenderTransform>

                        <Border.Effect>
                            <DropShadowEffect x:Name="BtnGlow"
                                              Color="{DynamicResource Color.Accent.PurpleLight}"
                                              BlurRadius="12"
                                              ShadowDepth="0"
                                              Opacity="0.5"/>
                        </Border.Effect>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <!-- Lightning / Spark Icon -->
                            <Path x:Name="IconLightning"
                                  Data="M6,1 L1,8 L5.5,8 L4,14 L11,6 L6.5,6 Z"
                                  Fill="#FFFFFF"
                                  Width="12"
                                  Height="14"
                                  Stretch="Uniform"
                                  Margin="0,0,7,0"
                                  VerticalAlignment="Center"/>

                            <TextBlock x:Name="TxtActivate"
                                       Text="ACTIVATE WORKSPACE"
                                       FontFamily="{DynamicResource Font.Main}"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ActivateBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#9333EA" Offset="0"/>
                                        <GradientStop Color="#7C3AED" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ActivateBorder" Property="BorderBrush" Value="#E9D5FF"/>
                            <Setter TargetName="ActivateBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{DynamicResource Color.Accent.PurpleLight}"
                                                      BlurRadius="16"
                                                      ShadowDepth="0"
                                                      Opacity="0.85"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ActivateBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.015" ScaleY="1.015"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ActivateBorder" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#581C87" Offset="0"/>
                                        <GradientStop Color="#4C1D95" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="ActivateBorder" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</UserControl>
