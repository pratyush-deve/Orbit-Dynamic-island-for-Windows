<UserControl x:Class="Orbit.UI.Panels.SocialHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:components="clr-namespace:Orbit.UI.Components"
             mc:Ignorable="d" 
             d:DesignHeight="130" d:DesignWidth="400">

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" MouseLeftButtonDown="OnViewBackgroundMouseDown" ClipToBounds="False">
        <Grid.RowDefinitions>
            <!-- Row 0: Header with Back Button, Title, and Settings Gear Icon -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Dynamic Application Cards Grid with Smooth Scrolling -->
            <RowDefinition Height="*"/>
            <!-- Row 2: Subtle Horizontal Scroll Progress Indicator (Visible only when apps overflow) -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Toolbar -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <!-- Back Button -->
                <ColumnDefinition Width="Auto"/>
                <!-- Title & Badge -->
                <ColumnDefinition Width="*"/>
                <!-- Settings Gear Icon Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back to Dashboard Button -->
            <Button x:Name="BtnBack"
                    Grid.Column="0"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnBackClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Left Arrow Glyph -->
                            <Path x:Name="ArrowGlyph"
                                  Data="M9,4 L5,8 L9,12 M5,8 L13,8"
                                  Stroke="{DynamicResource Brush.Text.Muted}"
                                  StrokeThickness="1.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="BackBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="BackBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleGlow}"/>
                                <Setter TargetName="BackBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Title & Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <TextBlock Text="Social Hub"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="13"
                           FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           VerticalAlignment="Center"/>

                <Border Background="#2B1A4A"
                        BorderBrush="{DynamicResource Brush.Accent.Border}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="6,1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="SOCIAL"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Brush.Accent.PurpleLight}"/>
                </Border>
            </StackPanel>

            <!-- Settings Gear Button -> Navigates to Manage Social Apps -->
            <Button x:Name="BtnManageApps"
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="OnManageAppsClicked">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SettingsBorder"
                                Background="#221834"
                                BorderBrush="#472C6F"
                                BorderThickness="1"
                                CornerRadius="6"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>

                            <!-- Gear Glyph -->
                            <Path x:Name="GearGlyph"
                                  Data="M9,2 L11,2 L11.3,3.5 C11.7,3.6 12.1,3.8 12.4,4.1 L13.8,3.3 L14.8,4.3 L14,5.7 C14.3,6 14.5,6.4 14.6,6.8 L16.1,7.1 L16.1,8.9 L14.6,9.2 C14.5,9.6 14.3,10 14,10.3 L14.8,11.7 L13.8,12.7 L12.4,11.9 C12.1,12.2 11.7,12.4 11.3,12.5 L11,14 L9,14 L8.7,12.5 C8.3,12.4 7.9,12.2 7.6,11.9 L6.2,12.7 L5.2,11.7 L6,10.3 C5.7,10 5.5,9.6 5.4,9.2 L3.9,8.9 L3.9,7.1 L5.4,6.8 C5.5,6.4 5.7,6 6,5.7 L5.2,4.3 L6.2,3.3 L7.6,4.1 C7.9,3.8 8.3,3.6 8.7,3.5 Z M10,5.8 A2.2,2.2 0 1,0 10,10.2 A2.2,2.2 0 1,0 10,5.8 Z"
                                  Fill="{DynamicResource Brush.Text.Muted}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SettingsBorder" Property="Background" Value="#352458"/>
                                <Setter TargetName="SettingsBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="GearGlyph" Property="Fill" Value="{DynamicResource Brush.Accent.PurpleLight}"/>
                                <Setter TargetName="SettingsBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#C084FC"
                                                          BlurRadius="8"
                                                          ShadowDepth="0"
                                                          Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SettingsBorder" Property="Background" Value="#1C1032"/>
                                <Setter TargetName="SettingsBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.94" ScaleY="0.94"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- 2. Dynamic Adaptive Application Workspace Cards with Smooth Scrolling -->
        <ScrollViewer x:Name="AppsScrollViewer"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Disabled"
                      HorizontalScrollBarVisibility="Hidden"
                      Focusable="False"
                      CanContentScroll="False"
                      PanningMode="HorizontalOnly"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0"
                      Margin="0,0,0,2"
                      ScrollChanged="OnAppsScrollViewerScrollChanged"
                      PreviewMouseWheel="OnAppsScrollViewerPreviewMouseWheel">
            <ItemsControl x:Name="ItemsWorkspaceApps"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <components:DevAppCard App="{Binding}" Margin="4,2" Click="OnAppCardClicked"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty Workspace Fallback if 0 apps are selected -->
        <Border x:Name="EmptyWorkspacePrompt"
                Grid.Row="1"
                Background="#160F24"
                BorderBrush="#3D295F"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,10"
                Margin="0,2,0,2"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No applications selected"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Click the ⚙️ icon above to add apps"
                           FontFamily="{DynamicResource Font.Main}"
                           FontSize="9.5"
                           Foreground="#7C6D96"
                           Margin="0,3,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Subtle Horizontal Scroll Progress Indicator (Visible when apps overflow) -->
        <Border x:Name="AppsScrollTrack"
                Grid.Row="2"
                Width="90"
                Height="2.5"
                Visibility="Collapsed"
                Background="#221538"
                BorderBrush="#3E2368"
                BorderThickness="0.8"
                CornerRadius="1.25"
                HorizontalAlignment="Center"
                Margin="0,1,0,3"
                SnapsToDevicePixels="True"
                IsHitTestVisible="False">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border x:Name="AppsScrollThumb"
                        Height="2.5"
                        Width="28"
                        HorizontalAlignment="Left"
                        Background="#A855F7"
                        CornerRadius="1.25"
                        SnapsToDevicePixels="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="AppsScrollThumbTransform" X="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#A855F7" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
                    </Border.Effect>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
