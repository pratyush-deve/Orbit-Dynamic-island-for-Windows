<Window x:Class="Orbit.UI.AnnotationConfirmHideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORBIT — Confirm Hide"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Width="380" Height="175"
        KeyDown="OnWindowKeyDown">
    <Border Background="#1A122B"
            BorderBrush="#45A855F7"
            BorderThickness="1.2"
            CornerRadius="18"
            Padding="22,18"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header with Title & subtle icon -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="24" Height="24" CornerRadius="12" Background="#25A855F7" Margin="0,0,10,0">
                    <Path Data="M 12,3 L 2,21 L 22,21 Z M 12,9 L 12,14 M 12,17 L 12.01,17"
                          Stroke="#C084FC"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Width="13" Height="13"
                          Stretch="Uniform" />
                </Border>
                <TextBlock Text="Clear annotations and hide ORBIT?"
                           Foreground="#FFFFFF"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- Body Message -->
            <TextBlock Grid.Row="1"
                       Text="Your current screen annotations are temporary and will be cleared if you hide ORBIT."
                       Foreground="#A1A1AA"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Margin="0,10,0,10"
                       VerticalAlignment="Center" />

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Keep Annotating (NO) -->
                <Button x:Name="BtnCancel"
                        Content="Keep Annotating"
                        Width="125" Height="32"
                        Margin="0,0,10,0"
                        Foreground="#E4E4E7"
                        FontSize="11.5"
                        FontWeight="Medium"
                        Cursor="Hand"
                        Click="OnCancelClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    Background="#25FFFFFF"
                                    BorderBrush="#30FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#35FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Clear & Hide (YES) -->
                <Button x:Name="BtnConfirm"
                        Content="Clear &amp; Hide"
                        Width="110" Height="32"
                        Foreground="#FFFFFF"
                        FontSize="11.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnConfirmClicked">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    Background="#E11D48"
                                    BorderBrush="#F43F5E"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#F43F5E" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>

