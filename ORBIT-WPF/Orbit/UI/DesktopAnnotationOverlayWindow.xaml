<Window x:Class="Orbit.UI.DesktopAnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ORBIT Desktop Annotation Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False"
        WindowState="Normal"
        WindowStartupLocation="Manual">
    <Grid x:Name="OverlayRootGrid" Background="Transparent">
        <InkCanvas x:Name="AnnotationCanvas"
                   Background="Transparent" />
        <Border x:Name="ShutterFlashBorder"
                Background="#FFFFFF"
                Opacity="0.0"
                IsHitTestVisible="False" />
    </Grid>
</Window>

