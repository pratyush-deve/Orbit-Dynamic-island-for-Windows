<Window x:Class="Orbit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mascot="clr-namespace:Orbit.UI.Mascot"
        xmlns:panels="clr-namespace:Orbit.UI.Panels"
        xmlns:components="clr-namespace:Orbit.UI.Components"
        mc:Ignorable="d"
        Title="ORBIT"
        Icon="Assets/ORBIT.png"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="160"
        Height="38"
        SizeToContent="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseMove="OnWindowMouseMove"
        MouseLeave="OnWindowMouseLeave"
        AllowDrop="True"
        PreviewDragEnter="OnWindowPreviewDragEnter"
        PreviewDragOver="OnWindowPreviewDragOver"
        PreviewDragLeave="OnWindowPreviewDragLeave"
        Drop="OnWindowDrop">

    <Grid x:Name="RootLayout" Background="{x:Null}">
        
        <!-- 0. Dedicated Solid Signature Black Background for the Mascot Notch (Always opaque in both collapsed & expanded forms) -->
        <Path x:Name="MascotNotchPermanentBg"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Fill="{DynamicResource Brush.Gradient.CharcoalSurface}"
              Data="M 0,0 L 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0 L 160,0 Z"
              IsHitTestVisible="False"/>

        <!-- 1. Carved Notch & Island Continuous Solid Dark Obsidian Glass Background -->
        <Path x:Name="CollapsedNotchBg"
              Fill="{DynamicResource Brush.Gradient.CharcoalSurface}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Cursor="Hand"
              MouseEnter="OnMascotMouseEnter"
              MouseLeave="OnMascotMouseLeave"
              MouseLeftButtonDown="OnMascotClick"
              Data="M 0,0 L 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0 L 160,0 Z"/>

        <!-- 2. EXPANDED ISLAND CONTENT (Cards, header, subviews - fades in during Stage 2) -->
        <Grid x:Name="ExpandedView"
              Opacity="0.0"
              Visibility="Collapsed"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
            <panels:ExpandedIsland x:Name="IslandPanel"
                                   CollapseRequested="OnIslandCollapseRequested"
                                   HideRequested="OnHideRequested"/>
        </Grid>

        <!-- 2.5 Animated Binary Stream Overlay (Active Working state data flow, strictly clipped to notch cradle) -->
        <Canvas x:Name="BinaryStreamOverlay"
                Width="160" Height="38"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Opacity="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Canvas.Clip>
                <PathGeometry Figures="M 0,0 L 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0 L 160,0 Z"/>
            </Canvas.Clip>
            <Canvas.Effect>
                <DropShadowEffect x:Name="BinaryStreamGlow" Color="#A855F7" BlurRadius="4" ShadowDepth="0" Opacity="0.35"/>
            </Canvas.Effect>

                <!-- Left Column 1 (Outer Left) -->
                <TextBlock Canvas.Left="27" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformL1"/>
                    </TextBlock.RenderTransform>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" />
                </TextBlock>

                <!-- Left Column 2 (Mid Left) -->
                <TextBlock Canvas.Left="39" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformL2"/>
                    </TextBlock.RenderTransform>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#7C3AED" />
                </TextBlock>

                <!-- Left Column 3 (Inner Left, trailing) -->
                <TextBlock Canvas.Left="51" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center" Opacity="0.55">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformL3"/>
                    </TextBlock.RenderTransform>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#8B5CF6" /><LineBreak/>
                    <Run Text="0" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="1" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#8B5CF6" /><LineBreak/>
                    <Run Text="0" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="1" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" />
                </TextBlock>

                <!-- Right Column 3 (Inner Right, trailing) -->
                <TextBlock Canvas.Left="105" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center" Opacity="0.55">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformR3"/>
                    </TextBlock.RenderTransform>
                    <Run Text="1" Foreground="#8B5CF6" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#8B5CF6" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" />
                </TextBlock>

                <!-- Right Column 2 (Mid Right) -->
                <TextBlock Canvas.Left="117" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformR2"/>
                    </TextBlock.RenderTransform>
                    <Run Text="0" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="1" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="0" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="1" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="0" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="0" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="1" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="0" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="1" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="0" Foreground="#A855F7" />
                </TextBlock>

                <!-- Right Column 1 (Outer Right) -->
                <TextBlock Canvas.Left="129" Canvas.Top="0"
                           FontFamily="Consolas, Cascadia Code, Courier New"
                           FontSize="7.5" FontWeight="SemiBold"
                           LineStackingStrategy="BlockLineHeight" LineHeight="9"
                           TextAlignment="Center">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="StreamTransformR1"/>
                    </TextBlock.RenderTransform>
                    <Run Text="1" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="0" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="1" Foreground="#7C3AED" /><LineBreak/>
                    <Run Text="0" Foreground="#E9D5FF" /><LineBreak/>
                    <Run Text="0" Foreground="#6B46C1" /><LineBreak/>
                    <Run Text="1" Foreground="#A855F7" /><LineBreak/>
                    <Run Text="1" Foreground="#C084FC" /><LineBreak/>
                    <Run Text="0" Foreground="#7C3AED" />
                </TextBlock>
        </Canvas>

            <!-- 3. Subtle, Minimal Perimeter Outline (soft gradient descending from top bezel) -->
            <Path x:Name="CollapsedNotchOutline"
                  StrokeThickness="1.0"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="False"
                  Data="M 0,0 L 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0 L 160,0">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00A855F7" Offset="0.0"/>
                        <GradientStop Color="#00A855F7" Offset="0.10"/>
                        <GradientStop Color="#25A855F7" Offset="0.45"/>
                        <GradientStop Color="#60A855F7" Offset="0.80"/>
                        <GradientStop Color="#90C084FC" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <DropShadowEffect x:Name="CollapsedNotchGlow"
                                      Color="{DynamicResource Color.Accent.PurpleLight}"
                                      BlurRadius="5"
                                      ShadowDepth="0"
                                      Opacity="0.18"/>
                </Path.Effect>
            </Path>

            <!-- 3.5 Faint Indication of the Mascot Notch Boundary (Shelf line separating notch from dashboard) -->
            <Path x:Name="MascotNotchBoundaryIndicator"
                  StrokeThickness="1.0"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  IsHitTestVisible="False"
                  Data="M 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0">
                <Path.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00A855F7" Offset="0.0"/>
                        <GradientStop Color="#15A855F7" Offset="0.25"/>
                        <GradientStop Color="#32A855F7" Offset="0.65"/>
                        <GradientStop Color="#4FC084FC" Offset="1.0"/>
                    </LinearGradientBrush>
                </Path.Stroke>
                <Path.Effect>
                    <DropShadowEffect x:Name="MascotNotchBoundaryGlow"
                                      Color="#A855F7"
                                      BlurRadius="4"
                                      ShadowDepth="0"
                                      Opacity="0.20"/>
                </Path.Effect>
            </Path>

            <!-- 4. Quick Actions Bar (File Dock, Voice Assistant, Annotation, Full Expand) -->
            <Grid x:Name="QuickActionsBar"
                  Width="310" Height="48"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Panel.ZIndex="10"
                  Opacity="0.0"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Background="Transparent"
                  MouseEnter="OnQuickActionsMouseEnter"
                  MouseLeave="OnQuickActionsMouseLeave">
                
                <!-- Standard Hover Quick Actions Bar -->
                <StackPanel x:Name="StandardQuickActionsPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,0,0,6">
                    <!-- 1. File Dock (Folder Icon) -->
                    <Button x:Name="BtnQuickFileDock"
                            Width="36" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="File Dock"
                            Focusable="False"
                            Click="OnFileDockButtonClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Path x:Name="FolderGlyph"
                                          Data="M 3,6 C 3,4.9 3.9,4 5,4 L 9,4 C 9.6,4 10.1,4.3 10.5,4.7 L 12,6.5 L 19,6.5 C 20.1,6.5 21,7.4 21,8.5 L 21,17 C 21,18.1 20.1,19 19,19 L 5,19 C 3.9,19 3,18.1 3,17 Z"
                                          Stroke="#D8B4FE"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="17" Height="14"
                                          Stretch="Uniform">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                        </Path.Effect>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#25A855F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Subtle Separator -->
                    <Rectangle Width="1" Height="14" Fill="#30A855F7" VerticalAlignment="Center" Margin="5,0,5,0"/>

                    <!-- 2. Voice Assistant (Mic Icon) -->
                    <Button x:Name="BtnQuickVoiceAssistant"
                            Width="36" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Voice Assistant"
                            Focusable="False"
                            Click="OnVoiceAssistantButtonClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Path Data="M 9,3 C 7.3,3 6,4.3 6,6 L 6,11 C 6,12.7 7.3,14 9,14 C 10.7,14 12,12.7 12,11 L 12,6 C 12,4.3 10.7,3 9,3 Z M 3,10 C 3,13.3 5.7,16 9,16 C 12.3,16 15,13.3 15,10 M 9,16 L 9,19 M 6,19 L 12,19"
                                          Stroke="#D8B4FE"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="14" Height="17"
                                          Stretch="Uniform">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                        </Path.Effect>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#25A855F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Subtle Separator -->
                    <Rectangle Width="1" Height="14" Fill="#30A855F7" VerticalAlignment="Center" Margin="5,0,5,0"/>

                    <!-- 3. Annotation (Pencil Icon) -->
                    <Button x:Name="BtnQuickAnnotation"
                            Width="36" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Annotation"
                            Focusable="False"
                            Click="OnQuickAnnotationClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Path Data="M 14.5,2.5 C 15.1,1.9 16.1,1.9 16.7,2.5 L 18.5,4.3 C 19.1,4.9 19.1,5.9 18.5,6.5 L 7,18 L 2.5,19.5 L 4,15 Z M 13,4 L 17,8 M 9,19.5 L 19,19.5"
                                          Stroke="#D8B4FE"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="16" Height="16"
                                          Stretch="Uniform">
                                        <Path.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                                        </Path.Effect>
                                    </Path>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#15A855F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Subtle Separator -->
                    <Rectangle Width="1" Height="14" Fill="#30A855F7" VerticalAlignment="Center" Margin="5,0,5,0"/>

                    <!-- 4. Full Expand (Outward Arrows in Purple Glowing Border) -->
                    <Button x:Name="BtnQuickFullExpand"
                            Width="30" Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Full Expand"
                            Click="OnFullExpandClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="#2A1B3D"
                                        BorderBrush="#A855F7"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="Glow" Color="#C084FC" BlurRadius="8" ShadowDepth="0" Opacity="0.55"/>
                                    </Border.Effect>
                                    <Path x:Name="Glyph"
                                          Data="M 6.5,2.5 L 2.5,2.5 L 2.5,6.5 M 2.5,2.5 L 6,6 M 11.5,2.5 L 15.5,2.5 L 15.5,6.5 M 15.5,2.5 L 12,6 M 2.5,11.5 L 2.5,15.5 L 6.5,15.5 M 2.5,15.5 L 6,12 M 15.5,11.5 L 15.5,15.5 L 11.5,15.5 M 15.5,15.5 L 12,12"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="12" Height="12"
                                          Stretch="Uniform"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#3D255A"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#C084FC"/>
                                        <Setter TargetName="Bg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="0.85"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#201330"/>
                                        <Setter TargetName="Bg" Property="BorderBrush" Value="#E9D5FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- In-Place Voice Mode Overlay (Centered inside 310 DIP notch, 54px from left/right margins) -->
                <Grid x:Name="VoiceModePanel"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Margin="56,0,56,6"
                      Visibility="Collapsed"
                      Opacity="0.0"
                      IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Glowing Microphone Icon on the Left -->
                    <Border Grid.Column="0"
                            Width="30" Height="26"
                            Background="#22A855F7"
                            BorderBrush="#A855F7"
                            BorderThickness="1"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Cursor="Hand"
                            ToolTip="Exit Voice Mode"
                            PreviewMouseLeftButtonDown="OnVoiceMicIconPreviewMouseDown">
                        <Border.Effect>
                            <DropShadowEffect Color="#C084FC" BlurRadius="8" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <Path Data="M 9,3 C 7.3,3 6,4.3 6,6 L 6,11 C 6,12.7 7.3,14 9,14 C 10.7,14 12,12.7 12,11 L 12,6 C 12,4.3 10.7,3 9,3 Z M 3,10 C 3,13.3 5.7,16 9,16 C 12.3,16 15,13.3 15,10 M 9,16 L 9,19 M 6,19 L 12,19"
                              Stroke="#F3E8FF"
                              StrokeThickness="1.5"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Width="13" Height="16"
                              Stretch="Uniform"/>
                    </Border>

                    <!-- Real-Time Audio Reactive Waveform -->
                    <components:VoiceWaveformControl x:Name="VoiceWaveform"
                                                     Grid.Column="1"
                                                     Height="26"
                                                     Margin="12,0,0,0"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"/>

                    <!-- Processing / Transcription Animation (Processing state) -->
                    <Grid x:Name="VoiceProcessingPanel"
                          Grid.Column="1"
                          Height="26"
                          Margin="12,0,0,0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"
                          Opacity="0.0">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <Ellipse x:Name="ProcessingDot1" Width="6" Height="6" Fill="#C084FC" Margin="3,0,3,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="ProcessingDot2" Width="6" Height="6" Fill="#A855F7" Margin="3,0,3,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#A855F7" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="ProcessingDot3" Width="6" Height="6" Fill="#C084FC" Margin="3,0,3,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#C084FC" BlurRadius="6" ShadowDepth="0" Opacity="0.8"/>
