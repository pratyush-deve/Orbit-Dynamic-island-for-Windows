                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- 9. White (#FFFFFF) -->
                            <Button x:Name="BtnPaletteColor_White"
                                    Tag="#FFFFFF"
                                    ToolTip="White"
                                    Width="22" Height="22"
                                    Margin="3,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    PreviewMouseLeftButtonDown="OnPaletteColorPreviewMouseDown"
                                    Click="OnPaletteColorClicked">
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="#FFFFFF" Stroke="#30FFFFFF" StrokeThickness="1"/>
                                    <Path x:Name="Check_White"
                                          Data="M 6.5,11 L 9.5,14 L 15.5,8"
                                          Stroke="#0F172A"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Button>

                            <!-- 10. Black (#0F172A) -->
                            <Button x:Name="BtnPaletteColor_Black"
                                    Tag="#0F172A"
                                    ToolTip="Black"
                                    Width="22" Height="22"
                                    Margin="3,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    PreviewMouseLeftButtonDown="OnPaletteColorPreviewMouseDown"
                                    Click="OnPaletteColorClicked">
                                <Grid Width="22" Height="22">
                                    <Ellipse Fill="#0F172A" Stroke="#475569" StrokeThickness="1"/>
                                    <Path x:Name="Check_Black"
                                          Data="M 6.5,11 L 9.5,14 L 15.5,8"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- 4.5 Staged File Dock Panel (Expands vertically below QuickActionsBar) -->
            <panels:FileDockView x:Name="FileDockPanel"
                                 Width="310" Height="106"
                                 Margin="0,42,0,0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Panel.ZIndex="10"
                                 Opacity="0.0"
                                 Visibility="Collapsed"
                                 CloseRequested="OnFileDockCloseRequested"
                                 PinToggleRequested="OnFileDockPinToggleRequested"/>

            <!-- 4.8 AI Response Bubble (Streams response progressively below the mascot notch) -->
            <Border x:Name="AiResponseBubble"
                    Width="380"
                    Margin="0,42,0,8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Panel.ZIndex="12"
                    CornerRadius="12"
                    BorderThickness="1.2"
                    BorderBrush="#A855F7"
                    Background="#160D27"
                    Padding="14,10"
                    Opacity="0.0"
                    Visibility="Collapsed"
                    MouseEnter="OnAiResponseBubbleMouseEnter"
                    MouseLeave="OnAiResponseBubbleMouseLeave">
                <Border.Effect>
                    <DropShadowEffect x:Name="AiResponseGlow" Color="#A855F7" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with green AI indicator dot and title -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="ORBIT AI" FontSize="10" FontWeight="Bold" Foreground="#C084FC"/>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Response Text with Sleek Scroll Indicator -->
                    <Grid Grid.Row="1" Margin="0,2,0,2">
                        <ScrollViewer x:Name="AiResponseScrollViewer"
                                      MaxHeight="180"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Focusable="False"
                                      ScrollChanged="OnAiResponseScrollChanged">
                            <TextBlock x:Name="AiResponseText"
                                       Text=""
                                       FontSize="11.5"
                                       LineHeight="16"
                                       Foreground="#F3E8FF"
                                       TextWrapping="Wrap"
                                       TextTrimming="None"/>
                        </ScrollViewer>

                        <!-- Minimal Glowing Scroll Indicator (Only visible when scrollable) -->
                        <Canvas x:Name="AiScrollIndicatorTrack"
                                Width="4"
                                HorizontalAlignment="Right"
                                Margin="0,2,0,2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <Border x:Name="AiScrollIndicatorThumb"
                                    Width="3"
                                    Height="24"
                                    CornerRadius="1.5"
                                    Background="#A855F7"
                                    Opacity="0.75"/>
                        </Canvas>
                    </Grid>

                    <!-- Clarification Action Panel (YES / NO buttons) -->
                    <StackPanel x:Name="ClarificationActionPanel"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="ClarificationYesButton"
                                Content="YES"
                                Width="64" Height="24"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Foreground="#FFFFFF"
                                Background="#10B981"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnClarificationYesClicked"/>
                        <Button x:Name="ClarificationNoButton"
                                Content="NO"
                                Width="64" Height="24"
                                FontWeight="SemiBold"
                                FontSize="11"
                                Foreground="#E2E8F0"
                                Background="#334155"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="OnClarificationNoClicked"/>
                    </StackPanel>

                    <!-- Voice Reply Panel (Small purple mic button in bottom-right corner when awaiting user input) -->
                    <StackPanel x:Name="AiVoiceReplyPanel"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,4,-4,-4"
                                Visibility="Collapsed">
                        <TextBlock Text="Reply by voice"
                                   FontSize="10.5"
                                   FontWeight="Normal"
                                   Foreground="#A78BFA"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   IsHitTestVisible="False"
                                   Opacity="0.85"/>
                        <Button x:Name="BtnAiVoiceReply"
                                Width="26" Height="26"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0"
                                Cursor="Hand"
                                ToolTip="Reply by voice"
                                Focusable="False"
                                PreviewMouseLeftButtonDown="OnAiVoiceReplyPreviewMouseDown"
                                Click="OnAiVoiceReplyButtonClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="MicBg"
                                            Background="#9333EA"
                                            CornerRadius="13"
                                            Width="26" Height="26"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#A855F7" BlurRadius="8" ShadowDepth="0" Opacity="0.6"/>
                                        </Border.Effect>
                                        <Path Data="M 9,3 C 7.3,3 6,4.3 6,6 L 6,11 C 6,12.7 7.3,14 9,14 C 10.7,14 12,12.7 12,11 L 12,6 C 12,4.3 10.7,3 9,3 Z M 3,10 C 3,13.3 5.7,16 9,16 C 12.3,16 15,13.3 15,10 M 9,16 L 9,19 M 6,19 L 12,19"
                                              Stroke="#FFFFFF"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="11" Height="14"
                                              Stretch="Uniform"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="MicBg" Property="Background" Value="#A855F7"/>
                                            <Setter TargetName="MicBg" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="MicBg" Property="Background" Value="#7E22CE"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Mascot Eyes & Mouth (Centered inside the carved notch cradle at all times, foreground) -->
            <Grid x:Name="MascotContainerGrid"
                  Width="160" Height="38"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Panel.ZIndex="11"
                  Background="Transparent"
                  Cursor="Hand"
                  MouseEnter="OnMascotMouseEnter"
                  MouseLeave="OnMascotMouseLeave"
                  MouseLeftButtonDown="OnMascotClick">
                <!-- Strict notch boundary clip: guarantees eyes & mouth can move throughout mascot area but never escape into parent box -->
                <Grid.Clip>
                    <PathGeometry Figures="M 0,0 L 18,0 C 25,0 33,7 36,14 C 39,21 46,30 54,30 L 106,30 C 114,30 121,21 124,14 C 127,7 135,0 142,0 L 160,0 Z"/>
                </Grid.Clip>
                <mascot:EyeMascot x:Name="PillMascot"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0"
                                  IsHitTestVisible="True">
                    <mascot:EyeMascot.LayoutTransform>
                        <ScaleTransform ScaleX="0.68" ScaleY="0.68"/>
                    </mascot:EyeMascot.LayoutTransform>
                </mascot:EyeMascot>
            </Grid>

            <!-- Compatibility element -->
            <Grid x:Name="CollapsedView" Visibility="Collapsed" IsHitTestVisible="False"/>
        </Grid>
</Window>
