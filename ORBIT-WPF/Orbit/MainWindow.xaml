                            Width="28" Height="26"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Exit Annotation"
                            Focusable="False"
                            Click="OnAnnotateBackClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg"
                                        Background="Transparent"
                                        CornerRadius="6"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                                    <Path Data="M 13,6 L 7,12 L 13,18 M 8,12 L 19,12"
                                          Stroke="#FFFFFF"
                                          StrokeThickness="1.8"
                                          StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Width="13" Height="13"
                                          Stretch="Uniform"/>
                                </Border>
