                            BorderThickness="0"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip="Cursor / Select"
                            Focusable="False"
                            Margin="2,0,2,0"
                            Click="OnAnnotateCursorClicked"
                            MouseEnter="OnAnnotateToolButtonMouseEnter"
                            MouseLeave="OnAnnotateToolButtonMouseLeave">
                        <Border x:Name="BorderAnnotateCursorBg"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1.0" ScaleY="1.0"/>
                            </Border.RenderTransform>
                            <Path x:Name="IconAnnotateCursor"
                                  Data="M 4,2 L 4,17.5 L 8.5,13.5 L 13.5,19.5 L 15.5,18 L 10.5,12 L 16.5,12 Z"
                                  Fill="#38BDF8"
                                  Stroke="#38BDF8"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="13" Height="15"
